      <!-- Bathroom deep clean -->
      <article class="purelane-bundle">
        <div class="purelane-bundle__top">
          <span class="purelane-bundle__saving">You save ₹398</span>
        </div>

        <div class="purelane-bundle__products">
          <span>Toilet Cleaner</span>
