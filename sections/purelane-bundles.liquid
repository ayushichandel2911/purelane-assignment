        <div class="purelane-bundle__top">
          <span class="purelane-bundle__saving">Biggest saving</span>
          <span class="purelane-bundle__tag">Best value</span>
        </div>

        <div class="purelane-bundle__products">
          <span>Kitchen Cleaner</span>
          <b>+</b>
          <span>Laundry Detergent</span>
          <b>+</b>
          <span>Floor Cleaner</span>
          <b>+</b>
          <span>Toilet Cleaner</span>
          <b>+</b>
          <span>Handwash</span>
        </div>

        <div class="purelane-bundle__body">
          <h3>Complete home bundle</h3>
