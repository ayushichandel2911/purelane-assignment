<style>
  .purelane-bundles {
    padding: 90px 20px;
    width: 100%;
    background: #17102b;
  }

  .purelane-bundles__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .purelane-bundles__header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 40px;
  }

  .purelane-bundles__kicker {
    display: inline-block;
    margin-bottom: 12px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .22em;
    color: rgba(236,230,247,.52);
  }

  .purelane-bundles__header h2 {
    margin: 0 0 14px;
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    color: #faf7fd;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.0;
    letter-spacing: -.03em;
  }

  .purelane-bundles__header p {
    margin: 0;
    color: rgba(236,230,247,.74);
    font-size: 15px;
    line-height: 1.6;
  }

  .purelane-bundles__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .purelane-bundle {
    border: 1px solid rgba(236,230,247,.22);
    border-radius: 22px;
    overflow: hidden;
    background: linear-gradient(158deg, rgba(236,230,247,.10), rgba(75,58,143,.20));
    transition: transform .25s ease, box-shadow .25s ease;
  }

  .purelane-bundle:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 35px rgba(18,12,34,.35);
  }

  .purelane-bundle--featured {
    border-width: 2px;
    border-color: #f0a03c;
  }

  .purelane-bundle__top {
    min-height: 42px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .purelane-bundle__saving {
    font-size: 12px;
    font-weight: 700;
    color: #f0a03c;
  }

  .purelane-bundle__tag {
    padding: 5px 9px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    border: 1px solid rgba(236,230,247,.4);
    color: #faf7fd;
  }

  .purelane-bundle__products {
    min-height: 155px;
    padding: 24px 18px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-content: center;
    align-items: center;
    gap: 8px;
    text-align: center;
    border-top: 1px solid rgba(236,230,247,.15);
    border-bottom: 1px solid rgba(236,230,247,.15);
  }

  .purelane-bundle__products span {
    font-size: 12px;
    font-weight: 600;
    padding: 8px 10px;
    border-radius: 10px;
    background: rgba(236,230,247,.08);
    color: #ece6f7;
  }

  .purelane-bundle__products b {
    color: rgba(236,230,247,.4);
  }

  .purelane-bundle__body {
    padding: 24px;
  }

  .purelane-bundle__body h3 {
    margin: 0 0 5px;
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    color: #faf7fd;
    font-size: 23px;
    line-height: 1.2;
  }

  .purelane-bundle__count {
    font-size: 12px;
    color: rgba(236,230,247,.55);
  }

  .purelane-bundle__body p {
    margin: 16px 0;
    color: rgba(236,230,247,.7);
    font-size: 13px;
    line-height: 1.55;
  }

  .purelane-bundle__price {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 7px;
  }

  .purelane-bundle__price strong {
    color: #faf7fd;
    font-size: 27px;
  }

  .purelane-bundle__price s {
    color: rgba(236,230,247,.5);
    font-size: 13px;
  }

  .purelane-bundle__price em {
    color: #f0a03c;
    font-size: 11px;
    font-style: normal;
    font-weight: 700;
  }

  .purelane-bundle__body small {
    display: block;
    margin-bottom: 18px;
    color: rgba(236,230,247,.5);
    font-size: 10px;
  }

  .purelane-bundle__button {
    display: block;
    width: 100%;
    padding: 13px 18px;
    border: 1px solid rgba(236,230,247,.3);
    border-radius: 999px;
    text-align: center;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    color: #faf7fd;
    background: rgba(236,230,247,.1);
    transition: transform .2s ease, background .2s ease;
  }

  .purelane-bundle__button:hover {
    transform: translateY(-2px);
    background: rgba(236,230,247,.18);
  }

  .purelane-bundles__note {
    margin: 20px auto 0;
    max-width: 650px;
    text-align: center;
    color: rgba(236,230,247,.5);
    font-size: 11px;
    line-height: 1.5;
  }

  @media screen and (max-width: 899px) {
    .purelane-bundles__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 599px) {
    .purelane-bundles {
      padding: 55px 16px;
    }

    .purelane-bundles__grid {
      grid-template-columns: 1fr;
    }

    .purelane-bundle__products {
      min-height: 130px;
    }
  }
</style>


