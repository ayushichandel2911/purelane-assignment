<section class="purelane-bundles" id="bundles-{{ section.id }}">
  <div class="purelane-bundles__container">

    <div class="purelane-bundles__header">
      <span class="purelane-bundles__kicker">Pre-built to save you money</span>

      <h2>Best selling combos</h2>

