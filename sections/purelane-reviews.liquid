<section class="purelane-reviews" id="reviews-{{ section.id }}">
  <div class="purelane-reviews__container">

    <div class="purelane-reviews__header">
      <span class="purelane-reviews__kicker">That's what they said</span>

      <div class="purelane-reviews__stats">
        <span>★★★★★ <strong>4.8</strong> from 8,000+ reviews</span>
        <span>Loved by <strong>12 lakh+</strong> homes</span>
      </div>
    </div>

    <div class="purelane-reviews__grid">

      <article class="purelane-review">
        <div class="purelane-review__stars">★★★★★</div>
        <h3>Works like a charm</h3>
        <p>
          Finally an eco option that cleans as well as the chemical detergent
          I used for years, and it smells better.
        </p>
        <div class="purelane-review__author">
          <strong>Anita</strong>
          <span>· Laundry detergent</span>
        </div>
      </article>

      <article class="purelane-review">
        <div class="purelane-review__stars">★★★★★</div>
        <h3>Best dishwash ever</h3>
        <p>
          Our old dishwash left my help with dry, cracked skin. That stopped
          completely after we switched.
        </p>
        <div class="purelane-review__author">
          <strong>Priya</strong>
          <span>· Dishwash gel</span>
        </div>
      </article>

      <article class="purelane-review">
        <div class="purelane-review__stars">★★★★★</div>
        <h3>Great product, great packaging</h3>
        <p>
          Very soft on hands with a lovely fragrance, and it feels good to be
          using far less plastic.
        </p>
        <div class="purelane-review__author">
          <strong>Sunita</strong>
          <span>· Liquid handwash</span>
        </div>
      </article>

      <article class="purelane-review">
        <div class="purelane-review__stars">★★★★★</div>
        <h3>Dog friendly</h3>
        <p>
          We switched because chemical floor cleaners were setting off my
          dog's allergies. No reactions since.
        </p>
        <div class="purelane-review__author">
          <strong>Rohit S.</strong>
          <span>· Floor cleaner</span>
        </div>
      </article>

      <article class="purelane-review">
        <div class="purelane-review__stars">★★★★★</div>
        <h3>Sparkling taps again</h3>
        <p>
          Hard water had ruined our bathroom fittings. Two sprays and the scale
          wipes straight off, no scrubbing.
        </p>
        <div class="purelane-review__author">
          <strong>Verified buyer</strong>
          <span>· Tap cleaner</span>
        </div>
      </article>

    </div>

  </div>
</section>


<style>
  .purelane-reviews {
    width: 100%;
    padding: 90px 20px;
    background: #17102b;
  }

  .purelane-reviews__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .purelane-reviews__header {
    text-align: center;
    margin-bottom: 35px;
  }

  .purelane-reviews__kicker {
    display: block;
    margin-bottom: 15px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .22em;
    color: rgba(236,230,247,.52);
  }

  .purelane-reviews__stats {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 18px;
    font-size: 13px;
  }

  .purelane-reviews__stats span {
    padding: 9px 14px;
    border: 1px solid rgba(236,230,247,.3);
    border-radius: 999px;
    color: #ece6f7;
    background: rgba(236,230,247,.08);
  }

  .purelane-reviews__stats strong {
    color: #f0a03c;
    font-weight: 700;
  }

  .purelane-reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .purelane-review {
    padding: 26px;
    border: 1px solid rgba(236,230,247,.22);
    border-radius: 20px;
    background: linear-gradient(158deg, rgba(236,230,247,.10), rgba(75,58,143,.20));
  }

  .purelane-review__stars {
    margin-bottom: 13px;
    font-size: 14px;
    letter-spacing: 2px;
    color: #f0a03c;
  }

  .purelane-review h3 {
    margin: 0 0 10px;
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    color: #faf7fd;
    font-size: 19px;
  }

  .purelane-review p {
    margin: 0 0 20px;
    color: rgba(236,230,247,.74);
    font-size: 13px;
    line-height: 1.6;
  }

  .purelane-review__author {
    display: flex;
    gap: 5px;
    font-size: 12px;
    color: #ece6f7;
  }

  .purelane-review__author span {
    color: rgba(236,230,247,.55);
  }

  @media screen and (max-width: 899px) {
    .purelane-reviews__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 599px) {
    .purelane-reviews {
      padding: 55px 16px;
    }

    .purelane-reviews__grid {
      grid-template-columns: 1fr;
    }

    .purelane-reviews__stats {
      flex-direction: column;
      align-items: center;
    }
  }
</style>


{% schema %}
{
  "name": "Purelane Reviews",
  "tag": "section",
  "class": "section-purelane-reviews",
  "settings": [],
  "presets": [
    {
      "name": "Purelane Reviews"
    }
  ]
}
{% endschema %}