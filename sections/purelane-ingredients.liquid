<section class="purelane-ingredients">
  <div class="purelane-ingredients__container">

    <div class="purelane-ingredients__intro">
      <p class="purelane-ingredients__eyebrow">
        {{ section.settings.eyebrow }}
      </p>

      <h2 class="purelane-ingredients__heading">
        {{ section.settings.heading }}
      </h2>

      <p class="purelane-ingredients__description">
        {{ section.settings.description }}
      </p>
    </div>

    <div class="purelane-ingredients__grid">

      {% for block in section.blocks %}

        <article
          class="purelane-ingredient-card"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.image != blank %}
            <div class="purelane-ingredient-card__image">
              {{
                block.settings.image
                | image_url: width: 700
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 500, 700',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  alt: block.settings.title
              }}
            </div>
          {% else %}
            <div class="purelane-ingredient-card__placeholder">
              {{ block.settings.title }}
            </div>
          {% endif %}

          <div class="purelane-ingredient-card__content">

            <span class="purelane-ingredient-card__number">
              0{{ forloop.index }}
            </span>

            <h3>
              {{ block.settings.title }}
            </h3>

            <p>
              {{ block.settings.description }}
            </p>

          </div>

        </article>

      {% endfor %}

    </div>

  </div>
</section>


<style>
  .purelane-ingredients {
    background: #17102b;
    color: #ece6f7;
    padding: 100px 24px;
    font-family: 'Inter', sans-serif;
  }

  .purelane-ingredients__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .purelane-ingredients__intro {
    max-width: 650px;
    margin-bottom: 55px;
  }

  .purelane-ingredients__eyebrow {
    margin: 0 0 12px;
    color: #f0a03c;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .purelane-ingredients__heading {
    margin: 0;
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(48px, 7vw, 90px);
    line-height: .9;
    letter-spacing: -.05em;
    color: #faf7fd;
  }

  .purelane-ingredients__description {
    max-width: 560px;
    margin: 25px 0 0;
    color: rgba(236, 230, 247, .74);
    font-size: 17px;
    line-height: 1.65;
  }

  .purelane-ingredients__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
  }

  .purelane-ingredient-card {
    overflow: hidden;
    border-radius: 28px;
    background: linear-gradient(158deg, rgba(236,230,247,.10), rgba(75,58,143,.20));
    border: 1px solid rgba(236,230,247,.22);
    box-shadow: 0 15px 45px rgba(18,12,34,.35);
  }

  .purelane-ingredient-card__image {
    height: 330px;
    overflow: hidden;
  }

  .purelane-ingredient-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .4s ease;
  }

  .purelane-ingredient-card:hover
  .purelane-ingredient-card__image img {
    transform: scale(1.04);
  }

  .purelane-ingredient-card__placeholder {
    height: 330px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(75,58,143,.30);
    color: #ece6f7;
    font-size: 28px;
    font-weight: 600;
  }

  .purelane-ingredient-card__content {
    position: relative;
    padding: 30px;
  }

  .purelane-ingredient-card__number {
    display: block;
    margin-bottom: 12px;
    color: #f0a03c;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .12em;
  }

  .purelane-ingredient-card__content h3 {
    margin: 0 0 12px;
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    color: #faf7fd;
    font-size: 30px;
    letter-spacing: -.03em;
  }

  .purelane-ingredient-card__content p {
    margin: 0;
    max-width: 450px;
    color: rgba(236,230,247,.65);
    font-size: 15px;
    line-height: 1.65;
  }

  @media screen and (max-width: 749px) {
    .purelane-ingredients {
      padding: 70px 18px;
    }

    .purelane-ingredients__grid {
      grid-template-columns: 1fr;
    }

    .purelane-ingredient-card__image,
    .purelane-ingredient-card__placeholder {
      height: 270px;
    }
  }
</style>

{% schema %}
{
  "name": "Purelane Ingredients",
  "tag": "section",
  "class": "section-purelane-ingredients",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Plant powered"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sourced from nature"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Thoughtfully chosen plant-powered ingredients that help clean effectively while being kinder to your home."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Ingredient image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Ingredient name",
          "default": "Coconut"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "A plant-powered ingredient selected for effective everyday cleaning."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Ingredients",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "title": "Coconut",
            "description": "A plant-powered ingredient selected for effective everyday cleaning."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "Orange Peel",
            "description": "A naturally derived ingredient chosen to help tackle everyday grime."
          }
        }
      ]
    }
  ]
}
{% endschema %}