          PURELANE
        </a>

        <p>
          Plant-powered cleaning for a healthier home.
        </p>

        <small>
          Purelane Eco Products Pvt Ltd
        </small>
      </div>


      <!-- Shop -->
      <div class="purelane-footer__column">
        <h5>Shop</h5>

        <a href="/">Home</a>
        <a href="/collections/all">Skin</a>
        <a href="/collections/all">Starter kits</a>
      </div>


      <!-- About -->
      <div class="purelane-footer__column">
        <h5>About</h5>

        <a href="#how">How it works</a>
        <a href="#ingredients">Sustainability</a>
        <a href="#proof">FAQs</a>
        <a href="#reviews">Reviews</a>
