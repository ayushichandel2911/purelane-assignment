<section class="purelane-signup" id="signup-{{ section.id }}">
  <div class="purelane-signup__container">

    <span class="purelane-signup__kicker">
      Join the Purelane Club
    </span>

    <h2>Get ₹100 off your first bundle</h2>

    <p>
      Plus first access to new launches and restocks.
    </p>

    <form class="purelane-signup__form">
      <input
        type="email"
        name="contact[email]"
        placeholder="your@email.com"
        aria-label="Email address"
        required
      >

      <button type="submit">
        Get my ₹100 off
      </button>
    </form>

  </div>
</section>

<style>
  .purelane-signup {
    width: 100%;
    padding: 90px 20px;
    background: #17102b;
  }

  .purelane-signup__container {
    max-width: 900px;
    margin: 0 auto;
    padding: 55px 30px;
    text-align: center;
    border: 1px solid rgba(236,230,247,.22);
    border-radius: 26px;
    background: linear-gradient(158deg, rgba(236,230,247,.10), rgba(75,58,143,.20));
  }

  .purelane-signup__kicker {
    display: block;
    margin-bottom: 14px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .22em;
    color: rgba(236,230,247,.52);
  }

  .purelane-signup h2 {
    margin: 0 0 12px;
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    color: #faf7fd;
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.0;
  }

  .purelane-signup p {
    margin: 0 auto 28px;
    color: rgba(236,230,247,.74);
    font-size: 15px;
  }

  .purelane-signup__form {
    max-width: 520px;
    margin: 0 auto;
    display: flex;
    gap: 10px;
  }

  .purelane-signup__form input {
    flex: 1;
    min-width: 0;
    padding: 14px 18px;
    border: 1px solid rgba(236,230,247,.3);
    border-radius: 999px;
    font-size: 14px;
    background: rgba(236,230,247,.08);
    color: #faf7fd;
  }

  .purelane-signup__form input::placeholder {
    color: rgba(236,230,247,.5);
  }

  .purelane-signup__form button {
    padding: 14px 22px;
    border: 0;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .1em;
    cursor: pointer;
    background: linear-gradient(135deg, #c9761d, #f0a03c);
    color: #08211a;
  }

  @media screen and (max-width: 599px) {

{% schema %}
